# Banco usado pela aplicação e pelo compose local
DB_NAME=financebot
DB_USER=postgres
DB_PASSWORD=troque-por-uma-senha-local-forte
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/financebot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=troque-por-uma-senha-local-forte
REDIS_SSL_ENABLED=false

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=financebot_local
RABBITMQ_PASSWORD=troque-por-uma-senha-local-forte
RABBITMQ_VHOST=/financebot
RABBITMQ_SSL_ENABLED=false

# Autenticação e proteção de dados
JWT_SECRET=troque-por-uma-chave-local-com-mais-de-64-caracteres
JWT_EXPIRATION=86400000
FINANCEBOT_DATA_ENCRYPTION_KEY=gere-uma-chave-base64-de-32-bytes
FINANCEBOT_DATA_ENCRYPTION_ACTIVE_KEY_ID=primary
FINANCEBOT_DATA_ENCRYPTION_LEGACY_KEY_ID=primary
FINANCEBOT_DATA_ENCRYPTION_PREVIOUS_KEYS=
FINANCEBOT_DATA_ENCRYPTION_ROTATION_ENABLED=false
FINANCEBOT_DATA_ENCRYPTION_ROTATION_BACKUP_CONFIRMED=false
FINANCEBOT_DATA_ENCRYPTION_ROTATION_BATCH_SIZE=100
FINANCEBOT_DATA_ENCRYPTION_ROTATION_INTERVAL_MS=1000

# API e integrações
CORS_ALLOWED_ORIGINS=http://localhost:5173
TELEGRAM_INTERNAL_TOKEN=gere-um-token-local-forte
FINANCEBOT_SQL_LOGGING_ENABLED=false
FINANCEBOT_LOG_FORMAT=ecs

# Tarefas agendadas e lembretes
FINANCEBOT_RECURRING_SCHEDULER_CRON=0 0 0 * * *
FINANCEBOT_REMINDERS_PUBLISH_INTERVAL=60000
FINANCEBOT_REMINDERS_QUEUE_MESSAGE_TTL_MS=86400000
FINANCEBOT_ALERTS_ENABLED=true
FINANCEBOT_ALERTS_SCHEDULER_CRON=0 0 9 * * *
FINANCEBOT_ALERTS_QUEUE_MESSAGE_TTL_MS=604800000

# Actuator local da API
FINANCEBOT_MANAGEMENT_PORT=8082
FINANCEBOT_MANAGEMENT_ADDRESS=127.0.0.1

# Observabilidade local (usado por compose.observability.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-local-forte
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
