# Telegram e API
TELEGRAM_BOT_TOKEN=troque-pelo-token-do-seu-bot
FINANCEBOT_API_URL=http://localhost:8080
TELEGRAM_INTERNAL_TOKEN=use-o-mesmo-token-configurado-na-api

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=use-a-senha-do-compose-local
REDIS_SSL_ENABLED=false
TELEGRAM_STATE_STORE=redis
TELEGRAM_CONVERSATION_CONTEXT_TTL=30m
TELEGRAM_QUERY_CONTEXT_TTL=30m

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=financebot_local
RABBITMQ_PASSWORD=use-a-senha-do-compose-local
RABBITMQ_VHOST=/financebot
RABBITMQ_SSL_ENABLED=false

# Interpretação por IA (opcional; desabilitada por padrão)
FINANCEBOT_AI_ENABLED=false
FINANCEBOT_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
FINANCEBOT_AI_API_KEY=cole-a-chave-apenas-no-env-local
FINANCEBOT_AI_MODEL=gpt-4o-mini
FINANCEBOT_AI_TIMEOUT=10s
FINANCEBOT_AI_TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
FINANCEBOT_AI_TRANSCRIPTION_MODEL=whisper-1

# Actuator local do bot
FINANCEBOT_MANAGEMENT_PORT=8083
FINANCEBOT_MANAGEMENT_ADDRESS=127.0.0.1
FINANCEBOT_LOG_FORMAT=ecs
